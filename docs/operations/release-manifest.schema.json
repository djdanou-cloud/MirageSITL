{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "reasons",
    "metrics",
    "sourceRevision",
    "dirty",
    "artifacts",
    "totalBytes",
    "systemReportSha256",
    "packageLockSha256",
    "datasetRegistrySha256",
    "toolchain",
    "supportedModes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "release-manifest"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED_EXTERNAL"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "dirty": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "license"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0
    },
    "systemReportSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packageLockSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "datasetRegistrySha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "toolchain": {
      "type": "object"
    },
    "supportedModes": {
      "type": "object"
    },
    "validatorSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
