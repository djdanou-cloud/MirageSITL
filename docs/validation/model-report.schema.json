{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "numericalStatus",
    "fidelityStatus",
    "referenceSha256",
    "artifactSha256",
    "cases",
    "blockers",
    "positionToleranceM",
    "attitudeToleranceRad",
    "diagnostics",
    "contactFidelityStatus",
    "measuredValidation",
    "propellerFidelityStatus",
    "propellerValidation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "status": {
      "enum": [
        "pass",
        "failed",
        "blocked"
      ]
    },
    "numericalStatus": {
      "enum": [
        "pass",
        "failed"
      ]
    },
    "fidelityStatus": {
      "enum": [
        "pass",
        "failed",
        "blocked"
      ]
    },
    "referenceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactSha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scalar",
        "simd128"
      ],
      "properties": {
        "scalar": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "simd128": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "positionToleranceM": {
      "const": 0.1
    },
    "attitudeToleranceRad": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.00872664626
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "hz",
          "variant",
          "positionErrorM",
          "attitudeErrorRad",
          "analyticErrorM",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "hz": {
            "enum": [
              400,
              800,
              1200
            ]
          },
          "variant": {
            "enum": [
              "scalar",
              "simd128"
            ]
          },
          "positionErrorM": {
            "type": "number",
            "minimum": 0
          },
          "attitudeErrorRad": {
            "type": "number",
            "minimum": 0
          },
          "analyticErrorM": {
            "type": [
              "number",
              "null"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "failed"
            ]
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contact",
        "jsbsimNative",
        "contactNativePatched",
        "jsbsimNativePatched"
      ],
      "properties": {
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "status",
            "reportSha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "status": {
              "enum": [
                "missing",
                "invalid",
                "stale",
                "pass",
                "failed"
              ]
            },
            "reportSha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "jsbsimNative": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "status",
            "reportSha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "status": {
              "enum": [
                "missing",
                "invalid",
                "stale",
                "pass",
                "failed"
              ]
            },
            "reportSha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "contactNativePatched": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "status",
            "reportSha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "status": {
              "enum": [
                "missing",
                "invalid",
                "stale",
                "pass",
                "failed"
              ]
            },
            "reportSha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "jsbsimNativePatched": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "status",
            "reportSha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "status": {
              "enum": [
                "missing",
                "invalid",
                "stale",
                "pass",
                "failed"
              ]
            },
            "reportSha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "contactFidelityStatus": {
      "enum": [
        "pass",
        "failed",
        "blocked"
      ]
    },
    "measuredValidation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "datasetId",
          "referenceUrl",
          "license",
          "acquiredAt",
          "sourceSha256",
          "consistencyStatus",
          "status",
          "runs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "datasetId": {
            "type": "string"
          },
          "referenceUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "license": {
            "type": "string"
          },
          "acquiredAt": {
            "type": "string"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "consistencyStatus": {
            "enum": [
              "pass",
              "failed"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "failed"
            ]
          },
          "runs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "caseId",
                "hz",
                "sinkRateMps",
                "peakAccelerationDownMps2",
                "windowedPeakAccelerationDownMps2",
                "measuredMinAccelerationDownMps2",
                "maxPenetrationM",
                "measuredMaxStrutStrokeM",
                "arrestImpulseNs",
                "sinkMomentumNs",
                "impulseBalanceErrorNs",
                "reboundSpeedMps",
                "checks"
              ],
              "properties": {
                "caseId": {
                  "type": "string"
                },
                "hz": {
                  "enum": [
                    400,
                    800,
                    1200
                  ]
                },
                "sinkRateMps": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "peakAccelerationDownMps2": {
                  "type": "number"
                },
                "windowedPeakAccelerationDownMps2": {
                  "type": "number"
                },
                "measuredMinAccelerationDownMps2": {
                  "type": "number"
                },
                "maxPenetrationM": {
                  "type": "number"
                },
                "measuredMaxStrutStrokeM": {
                  "type": "number"
                },
                "arrestImpulseNs": {
                  "type": "number"
                },
                "sinkMomentumNs": {
                  "type": "number"
                },
                "impulseBalanceErrorNs": {
                  "type": "number"
                },
                "reboundSpeedMps": {
                  "type": "number"
                },
                "checks": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "impulse",
                    "nonpenetration",
                    "energy",
                    "decelerationEnvelope",
                    "strokeEnvelope"
                  ],
                  "properties": {
                    "impulse": {
                      "enum": [
                        "pass",
                        "failed"
                      ]
                    },
                    "nonpenetration": {
                      "enum": [
                        "pass",
                        "failed"
                      ]
                    },
                    "energy": {
                      "enum": [
                        "pass",
                        "failed"
                      ]
                    },
                    "decelerationEnvelope": {
                      "enum": [
                        "pass",
                        "failed"
                      ]
                    },
                    "strokeEnvelope": {
                      "enum": [
                        "pass",
                        "failed"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "propellerFidelityStatus": {
      "enum": [
        "pass",
        "failed",
        "blocked"
      ]
    },
    "propellerValidation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "datasetId",
          "referenceUrl",
          "license",
          "acquiredAt",
          "sourceSha256",
          "inventorySha256",
          "archiveDataSha256",
          "consistencyStatus",
          "audit",
          "status",
          "polar",
          "tolerance",
          "totals",
          "propellers"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "datasetId": {
            "type": "string"
          },
          "referenceUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "license": {
            "type": "string"
          },
          "acquiredAt": {
            "type": "string"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "inventorySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "archiveDataSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "consistencyStatus": {
            "enum": [
              "pass",
              "failed"
            ]
          },
          "audit": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "points",
              "applicable",
              "etaInconsistent",
              "aboveFroudeBound"
            ],
            "properties": {
              "points": {
                "type": "integer",
                "minimum": 0
              },
              "applicable": {
                "type": "integer",
                "minimum": 0
              },
              "etaInconsistent": {
                "type": "integer",
                "minimum": 0
              },
              "aboveFroudeBound": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "status": {
            "enum": [
              "pass",
              "failed",
              "unvalidated"
            ]
          },
          "polar": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "airfoil",
              "zeroLiftAlphaRad",
              "liftSlopePerRad",
              "alphaRangeRad",
              "reynoldsRange"
            ],
            "properties": {
              "kind": {
                "const": "thin-airfoil-laminar-friction"
              },
              "airfoil": {
                "const": "SDA1075"
              },
              "zeroLiftAlphaRad": {
                "type": "number"
              },
              "liftSlopePerRad": {
                "type": "number"
              },
              "alphaRangeRad": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "reynoldsRange": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "tolerance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ctRelative",
              "ctAbsolute",
              "cpRelative",
              "cpAbsolute"
            ],
            "properties": {
              "ctRelative": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "ctAbsolute": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "cpRelative": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "cpAbsolute": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "totals": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "points",
              "compared",
              "passed",
              "ctWithinTolerance",
              "cpWithinTolerance",
              "outsidePolar",
              "outsideMomentum",
              "errors"
            ],
            "properties": {
              "points": {
                "type": "integer",
                "minimum": 0
              },
              "compared": {
                "type": "integer",
                "minimum": 0
              },
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "ctWithinTolerance": {
                "type": "integer",
                "minimum": 0
              },
              "cpWithinTolerance": {
                "type": "integer",
                "minimum": 0
              },
              "outsidePolar": {
                "type": "integer",
                "minimum": 0
              },
              "outsideMomentum": {
                "type": "integer",
                "minimum": 0
              },
              "errors": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "propellers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "bladeCount",
                "diameterM",
                "points",
                "compared",
                "passed",
                "ctWithinTolerance",
                "cpWithinTolerance",
                "outsidePolar",
                "outsideMomentum",
                "errors",
                "maxAbsCtError",
                "maxAbsCpError",
                "meanCtError",
                "meanCpError",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "bladeCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "diameterM": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "points": {
                  "type": "integer",
                  "minimum": 0
                },
                "compared": {
                  "type": "integer",
                  "minimum": 0
                },
                "passed": {
                  "type": "integer",
                  "minimum": 0
                },
                "ctWithinTolerance": {
                  "type": "integer",
                  "minimum": 0
                },
                "cpWithinTolerance": {
                  "type": "integer",
                  "minimum": 0
                },
                "outsidePolar": {
                  "type": "integer",
                  "minimum": 0
                },
                "outsideMomentum": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxAbsCtError": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "maxAbsCpError": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "meanCtError": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "meanCpError": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "pass",
                    "failed",
                    "unvalidated"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
