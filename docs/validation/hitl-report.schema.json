{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "reasons",
    "metrics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "hitl-report"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED_EXTERNAL"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "validatorSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
