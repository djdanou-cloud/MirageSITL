+void FGPropagate::ApplyBodyImpulse(const FGColumnVector3& deltaVelocity,
+                                  const FGColumnVector3& deltaRate)
+{
+  const auto deltaInertial = Tb2i * deltaVelocity;
+  const auto oldQdot = VState.vQtrndot;
+  VState.vInertialVelocity += deltaInertial;
+  VState.vPQRi += deltaRate;
+  CalculateUVW();
+  vVel = Tb2l * VState.vUVW;
+  VState.vPQR = VState.vPQRi - Ti2b * in.vOmegaPlanet;
+  CalculateQuatdot();
+  const auto deltaQdot = VState.vQtrndot - oldQdot;
+  // A discontinuity changes all positional derivative history samples by
+  // the same jump. Acceleration histories keep the continuous force terms.
+  // This avoids smearing an impulse through the Adams-Bashforth history.
+  for (auto& v : VState.dqInertialVelocity) v += deltaInertial;
+  for (auto& q : VState.dqQtrndot) q += deltaQdot;
+}
