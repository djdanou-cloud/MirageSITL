+    // @Range: 0 1
+    // @User: Advanced
+    AP_GROUPINFO("ACC_FLOOR",    57, SIM, accel_noise_floor, 0.01f),
+
+    // @Param: GYR_FLOOR
+    // @DisplayName: Gyro noise floor
+    // @Description: Amplitude of the uniform noise added to every simulated gyro sample at any throttle; with the motors off and no vibration it is added twice. The default reproduces the fixed upstream floor; 0 disables it.
+    // @Units: deg/s
+    // @Range: 0 10
+    // @User: Advanced
+    AP_GROUPINFO("GYR_FLOOR",    58, SIM, gyro_noise_floor, 0.04f),
+
     // the IMUT parameters must be last due to the enable parameters
 #if HAL_INS_TEMPERATURE_CAL_ENABLE

