diff --git a/libraries/AP_InertialSensor/AP_InertialSensor_SITL.cpp b/libraries/AP_InertialSensor/AP_InertialSensor_SITL.cpp
index 183f813..50d1da8 100644
--- a/libraries/AP_InertialSensor/AP_InertialSensor_SITL.cpp
+++ b/libraries/AP_InertialSensor/AP_InertialSensor_SITL.cpp
@@ -111,7 +111,8 @@ void AP_InertialSensor_SITL::generate_accel()

         // minimum noise levels are 2 bits, but averaged over many
         // samples, giving around 0.01 m/s/s
-        float accel_noise = 0.01f;
+        // MirageSITL patch: SIM_ACC_FLOOR defaults to 0.01; 0 disables the floor
+        float accel_noise = sitl->accel_noise_floor.get();
         float noise_variation = 0.05f;
         // this smears the individual motor peaks somewhat emulating physical motors
         float freq_variation = 0.12f;
@@ -222,7 +223,8 @@ void AP_InertialSensor_SITL::generate_gyro()
         float r = radians(sitl->state.yawRate) + _gyro_drift;

         // minimum gyro noise is less than 1 bit
-        float gyro_noise = radians(0.04f);
+        // MirageSITL patch: SIM_GYR_FLOOR defaults to 0.04; 0 disables the floor
+        float gyro_noise = radians(sitl->gyro_noise_floor.get());
         constexpr float noise_variation = 0.05f;
         // this smears the individual motor peaks somewhat emulating physical motors
         constexpr float freq_variation = 0.12f;
