diff --git a/src/mirage/compare.js b/src/mirage/compare.js
new file mode 100644
index 0000000..f1eb5bd
--- /dev/null
+++ b/src/mirage/compare.js
@@ -0,0 +1,39 @@
+// MirageSITL patch 0004: a second log beside the one the viewer has open, for comparing two flights
+// or two intervals of one flight (TASK-181). The viewer's own store holds one log, so this holds the
+// other, outside Vue's reactivity, because a log's arrays are too large to observe.
+// Alignment: `first` and `second` are the time ranges shown of each log, in each log's own
+// milliseconds, or null for all of it, and `secondOffsetMs` is added to the second log's times, in
+// overlay and in side by side alike. Both logs' curves share a value axis, so matching quantities
+// have one scale.
+
+export const NO_ALIGNMENT = Object.freeze({ mode: 'overlay', first: null, second: null, secondOffsetMs: 0 })
+
+export const compare = {
+    /** { name, messages, plotCache, types, requested, parsed } */
+    second: null,
+    alignment: NO_ALIGNMENT,
+    /** Events on the second flight's own timeline. */
+    secondEvents: [],
+    /** The next plot shows the aligned range instead of keeping the current zoom. */
+    resetRange: false
+}
+
+export function newSecondLog (name) {
+    return { name, messages: {}, plotCache: {}, types: null, requested: {}, parsed: false }
+}
+
+/** The part of a series inside `range`, or all of it. */
+export function windowOf (data, range) {
+    if (!range) {
+        return data
+    }
+    const x = []
+    const y = []
+    for (let i = 0; i < data.x.length; i++) {
+        if (data.x[i] >= range[0] && data.x[i] <= range[1]) {
+            x.push(data.x[i])
+            y.push(data.y[i])
+        }
+    }
+    return Object.assign({}, data, { x, y })
+}
