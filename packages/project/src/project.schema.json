{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mirage-sitl.invalid/schemas/project.schema.json",
  "title": "MirageSITL project record v1 and project archive manifest v1",
  "description": "Equivalent to validateRecord and validateManifest in schema.ts and archive.ts except for rules JSON Schema cannot express: canonical JSON (RFC 8785) bytes of at most 1 MiB and nesting depth 32; NFC, trimmed names without control, line-separator or bidirectional-control characters; a createdAt or exportedAt that round-trips through Date; projectId equal to id for a project and different from id otherwise; dependencies sorted by sha256 without duplicates; and the version-chain, dependency-closure and archive checks in versions.ts, archive.ts and store.ts.",
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "kind": {
      "enum": ["project", "component-card", "measurement-set", "aircraft-profile", "experiment"]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256"],
      "properties": {
        "kind": { "$ref": "#/definitions/kind" },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "id", "projectId", "version", "previous", "origin", "name", "createdAt", "dependencies", "payload"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "$ref": "#/definitions/kind" },
        "id": { "$ref": "#/definitions/uuid" },
        "projectId": { "$ref": "#/definitions/uuid" },
        "version": { "$ref": "#/definitions/version" },
        "previous": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/definitions/sha256" }
          ]
        },
        "origin": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["copiedFrom"],
              "properties": {
                "copiedFrom": { "$ref": "#/definitions/sha256" }
              }
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": { "$ref": "#/definitions/timestamp" },
        "dependencies": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/definitions/dependency" }
        },
        "payload": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "version": { "const": 1 } } },
          "then": { "properties": { "previous": { "type": "null" } } },
          "else": {
            "properties": {
              "previous": { "$ref": "#/definitions/sha256" },
              "origin": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "project" } } },
          "then": {
            "properties": {
              "origin": { "type": "null" },
              "dependencies": { "type": "array", "maxItems": 0 },
              "payload": { "type": "object", "maxProperties": 0 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "component-card" } } },
          "then": { "properties": { "dependencies": { "type": "array", "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "kind": { "const": "measurement-set" } } },
          "then": {
            "properties": {
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "kind": { "const": "component-card" } }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "aircraft-profile" } } },
          "then": {
            "properties": {
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "kind": { "enum": ["component-card", "measurement-set"] } }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "experiment" } } },
          "then": {
            "properties": {
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "kind": { "enum": ["aircraft-profile", "component-card", "measurement-set"] } }
                }
              }
            }
          }
        }
      ]
    },
    "archiveEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "kind", "id", "version"],
      "properties": {
        "sha256": { "$ref": "#/definitions/sha256" },
        "bytes": { "type": "integer", "minimum": 2, "maximum": 1048576 },
        "kind": { "$ref": "#/definitions/kind" },
        "id": { "$ref": "#/definitions/uuid" },
        "version": { "$ref": "#/definitions/version" }
      }
    },
    "archiveManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "formatVersion", "projectId", "exportedAt", "entries"],
      "properties": {
        "format": { "const": "mirage-project-archive" },
        "formatVersion": { "const": 1 },
        "projectId": { "$ref": "#/definitions/uuid" },
        "exportedAt": { "$ref": "#/definitions/timestamp" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "items": { "$ref": "#/definitions/archiveEntry" }
        }
      }
    }
  }
}
